# Mock mode is the default and needs no keys at all. The whole pipeline runs
# end to end against fixtures/llm/*.json, so tests and development cost nothing.
STUDYSYNTH_LLM__BACKEND=mock
STUDYSYNTH_EMBEDDINGS__BACKEND=mock

# Real mode. The key is read when a call is made, never at import time.
# ANTHROPIC_API_KEY=
# STUDYSYNTH_LLM__BACKEND=claude
# STUDYSYNTH_LLM__MODEL=claude-sonnet-5
# STUDYSYNTH_LLM__VISION_MODEL=claude-haiku-4-5
# STUDYSYNTH_LLM__EFFORT=high            # synthesis
# STUDYSYNTH_LLM__DRAFT_EFFORT=medium    # one call per concept, the largest job
# STUDYSYNTH_LLM__GRADING_EFFORT=low     # the seven controls: one number each
# STUDYSYNTH_EMBEDDINGS__BACKEND=qwen
# STUDYSYNTH_EMBEDDINGS__MODEL=Qwen/Qwen3-Embedding-0.6B

# Qdrant. `local` keeps the index on disk under data/qdrant, so a textbook is
# embedded once per course rather than once per run.
STUDYSYNTH_QDRANT__BACKEND=local
STUDYSYNTH_QDRANT__URL=http://localhost:6333

# Independent calls run concurrently. Raise if your rate limit allows.
STUDYSYNTH_RETRIEVAL__MAX_PARALLEL_GRADING=8
STUDYSYNTH_NOTES__MAX_PARALLEL_OCR=12

# Spec section 7. Every one of these is a mechanism, not a preference.
# The vector floor is a cosine cut before any model sees a candidate.
# 0 disables it; measure your model's score distribution before raising it.
STUDYSYNTH_RETRIEVAL__MIN_VECTOR_SCORE=0.0
STUDYSYNTH_RETRIEVAL__MIN_RELEVANCE=0.55
STUDYSYNTH_RETRIEVAL__MIN_NECESSITY=0.60
STUDYSYNTH_RETRIEVAL__MAX_SIMILARITY_TO_DRAFT=0.82
STUDYSYNTH_RETRIEVAL__NEW_CONCEPT_GUARD=true
STUDYSYNTH_RETRIEVAL__TEXTBOOK_TOKEN_BUDGET=1200
STUDYSYNTH_RETRIEVAL__MAX_TEXTBOOK_FRACTION=0.15

# PDF typesetting. Both must be on PATH; point these at the executables if not.
STUDYSYNTH_PDF__PANDOC=pandoc
STUDYSYNTH_PDF__ENGINE=xelatex
