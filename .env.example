# Mock mode is the default and needs no keys at all. Everything in the pipeline
# runs end to end against fixtures/llm/*.json.
STUDYSYNTH_LLM__BACKEND=mock
STUDYSYNTH_EMBEDDINGS__BACKEND=mock

# Real mode. The key is read when a call is made, never at import time.
# ANTHROPIC_API_KEY=
# STUDYSYNTH_LLM__BACKEND=claude
# STUDYSYNTH_LLM__MODEL=claude-opus-5
# STUDYSYNTH_LLM__EFFORT=high          # drafting and synthesis
# STUDYSYNTH_LLM__GRADING_EFFORT=low   # the seven controls: one number each
# STUDYSYNTH_EMBEDDINGS__BACKEND=qwen
# STUDYSYNTH_EMBEDDINGS__MODEL=Qwen/Qwen3-Embedding-8B
# STUDYSYNTH_EMBEDDINGS__DIMENSIONS=4096

# Qdrant: `local` keeps the index on disk under data/qdrant, so a textbook is
# embedded once per course rather than once per run. `memory` is for tests,
# `server` for the docker compose container.
STUDYSYNTH_QDRANT__BACKEND=local
STUDYSYNTH_QDRANT__URL=http://localhost:6333

# Spec section 7. Every one of these is a mechanism, not a preference.
STUDYSYNTH_RETRIEVAL__MIN_RELEVANCE=0.55
STUDYSYNTH_RETRIEVAL__MIN_NECESSITY=0.60
STUDYSYNTH_RETRIEVAL__MAX_SIMILARITY_TO_DRAFT=0.82
STUDYSYNTH_RETRIEVAL__NEW_CONCEPT_GUARD=true
STUDYSYNTH_RETRIEVAL__TEXTBOOK_TOKEN_BUDGET=1200
STUDYSYNTH_RETRIEVAL__MAX_TEXTBOOK_FRACTION=0.15

STUDYSYNTH_SERVER__HOST=127.0.0.1
STUDYSYNTH_SERVER__PORT=8000
